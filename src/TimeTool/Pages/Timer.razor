@namespace TimeTool.Pages

@page "/timer"
@inject IJSRuntime JS
@inject Services.TimerEngine Engine
@implements IDisposable

<PageTitle>Таймер</PageTitle>

<div class="page" tabindex="0" @onkeydown="OnKeyDown" @ref="PageDiv">
    <h2>Таймер обратного отсчёта</h2>

    <div class="duration-row">
        <label>Часы<input type="number" min="0" max="999" @bind="Hours" disabled="@Engine.IsRunning" /></label>
        <label>Минуты<input type="number" min="0" max="59" @bind="Minutes" disabled="@Engine.IsRunning" /></label>
        <label>Секунды<input type="number" min="0" max="59" @bind="Seconds" disabled="@Engine.IsRunning" /></label>
    </div>

    <div class="presets">
        @foreach (var p in Presets)
        {
            <button type="button" class="btn" @onclick="() => SetPreset(p)" disabled="@Engine.IsRunning">@PresetText(p)</button>
        }
    </div>

    <div class="sound-row">
        <label style="flex:1;">Звук по окончании (файл wav/mp3/ogg, пусто — стандартный сигнал)
            <input @bind="_soundPath" @bind:after="SaveAsync" placeholder="не выбран — стандартный сигнал" disabled="@Engine.IsRunning" />
        </label>
        <button type="button" class="btn" @onclick="PickSound" disabled="@Engine.IsRunning">Обзор…</button>
        <button type="button" class="btn" @onclick="TestSound" disabled="@Engine.IsRunning">Проверить</button>
    </div>

    <div class="big-display @(Engine.Finished ? "finished" : "")">@Display</div>

    <div class="progress"><div class="progress-bar" style="width: @ProgressPercent%"></div></div>

    <div class="controls">
        @if (!Engine.IsRunning && !Engine.IsPaused)
        {
            <button type="button" class="btn primary" @onclick="Start" disabled="@(Engine.Total == TimeSpan.Zero)">Старт</button>
        }
        else if (Engine.IsRunning)
        {
            <button type="button" class="btn" @onclick="Engine.Pause">Пауза</button>
            <button type="button" class="btn danger" @onclick="Reset">Сброс</button>
        }
        else
        {
            <button type="button" class="btn primary" @onclick="Engine.Resume">Продолжить</button>
            <button type="button" class="btn danger" @onclick="Reset">Сброс</button>
        }
    </div>
</div>

@code {
    private ElementReference PageDiv;
    private static readonly (int h, int m, int s)[] Presets = { (0, 1, 0), (0, 5, 0), (0, 15, 0), (0, 30, 0), (1, 0, 0) };

    private int Hours { get; set; }
    private int Minutes { get; set; } = 5;
    private int Seconds { get; set; }
    private string _soundPath = "";

    private string Display => Engine.Remaining < TimeSpan.Zero ? TimeSpan.Zero.ToString(@"hh\:mm\:ss") : Engine.Remaining.ToString(@"hh\:mm\:ss");
    private int ProgressPercent => Engine.Total == TimeSpan.Zero ? 0 : Math.Min(100, (int)(100 * (1 - Engine.Remaining.TotalSeconds / Engine.Total.TotalSeconds)));

    protected override void OnInitialized()
    {
        Engine.Changed += OnEngineChanged;
        _ = RestoreAsync();
    }

    private void OnEngineChanged()
    {
        try { _ = InvokeAsync(StateHasChanged); }
        catch (InvalidOperationException) { }
    }

    private async Task RestoreAsync()
    {
        try
        {
            var json = await JS.InvokeAsync<string?>("localStorage.getItem", "timetool-timer");
            if (!string.IsNullOrEmpty(json))
            {
                var s = System.Text.Json.JsonSerializer.Deserialize<SavedTimer>(json);
                if (s is not null)
                {
                    Hours = s.Hours;
                    Minutes = s.Minutes;
                    Seconds = s.Seconds;
                    _soundPath = s.SoundPath ?? "";
                    Engine.SoundPath = _soundPath;
                    Engine.Arm(CalcTotal());
                    await InvokeAsync(StateHasChanged);
                }
            }
        }
        catch { }
    }

    private TimeSpan CalcTotal()
    {
        var t = new TimeSpan(Math.Max(0, Hours), Math.Clamp(Minutes, 0, 59), Math.Clamp(Seconds, 0, 59));
        return t > new TimeSpan(999, 59, 59) ? new TimeSpan(999, 59, 59) : t;
    }

    private static string PresetText((int h, int m, int s) p)
    {
        var parts = new List<string>();
        if (p.h > 0)
            parts.Add($"{p.h} ч");
        if (p.m > 0)
            parts.Add($"{p.m} мин");
        if (p.s > 0)
            parts.Add($"{p.s} с");
        return string.Join(" ", parts);
    }

    private void SetPreset((int h, int m, int s) p)
    {
        Hours = p.h;
        Minutes = p.m;
        Seconds = p.s;
        Engine.Arm(CalcTotal());
    }

    private void Start()
    {
        Engine.Arm(CalcTotal());
        Engine.Start();
        _ = SaveAsync();
    }

    private void Reset()
    {
        Engine.Reset();
        _ = SaveAsync();
    }

    private async Task SaveAsync()
    {
        Engine.SoundPath = _soundPath;
        try
        {
            var json = System.Text.Json.JsonSerializer.Serialize(new SavedTimer { Hours = Hours, Minutes = Minutes, Seconds = Seconds, SoundPath = _soundPath });
            await JS.InvokeVoidAsync("localStorage.setItem", "timetool-timer", json);
        }
        catch { }
    }

    private async Task OnKeyDown(KeyboardEventArgs e)
    {
        if (e.Key != " " && e.Code != "Space")
            return;
        if (Engine.Finished)
            Reset();
        else if (Engine.IsRunning)
            Engine.Pause();
        else if (Engine.IsPaused)
            Engine.Resume();
        else
            Start();
        await Task.CompletedTask;
    }

    private async Task TestSound() => await PlayFinishSoundAsync();

    private async Task PickSound()
    {
#if WINDOWS
        var path = await Platforms.Windows.AudioPick.PickAudioAsync();
        if (!string.IsNullOrEmpty(path))
        {
            _soundPath = path;
            Engine.SoundPath = path;
            await SaveAsync();
            await TestSound();
        }
#endif
    }

    /// <summary>Кастомный звук из файла (base64 в WebView) либо стандартный сигнал.</summary>
    private async Task PlayFinishSoundAsync()
    {
        try
        {
            if (!string.IsNullOrWhiteSpace(_soundPath) && File.Exists(_soundPath))
            {
                var info = new FileInfo(_soundPath);
                if (info.Length is > 0 and <= 8 * 1024 * 1024) // WebView-интероп не любит гигантские сообщения
                {
                    var bytes = await File.ReadAllBytesAsync(_soundPath);
                    var mime = Path.GetExtension(_soundPath).ToLowerInvariant() switch
                    {
                        ".wav" => "audio/wav",
                        ".ogg" => "audio/ogg",
                        _ => "audio/mpeg",
                    };
                    var b64 = Convert.ToBase64String(bytes);
                    await JS.InvokeVoidAsync("playBase64", mime, b64);
                    return;
                }
            }
        }
        catch { }
        try { await JS.InvokeVoidAsync("beep", 3); } catch { }
    }

    public void Dispose()
    {
        Engine.Changed -= OnEngineChanged;
    }

    private sealed class SavedTimer
    {
        public int Hours { get; set; }
        public int Minutes { get; set; }
        public int Seconds { get; set; }
        public string? SoundPath { get; set; }
    }
}
