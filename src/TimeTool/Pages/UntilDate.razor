@namespace TimeTool.Pages
@page "/until"
@inject Services.TimeState State

<PageTitle>До даты</PageTitle>

<div class="page">
    <h2>Отсчёт до даты</h2>

    <div class="panel">
        <div class="shift-row">
            <label>Целевая дата
                <input type="date" @bind="TargetDate" @bind:format="yyyy-MM-dd" />
            </label>
            <label>Время (необязательно)
                <input type="time" @bind="TargetTime" @bind:format="HH:mm" />
            </label>
        </div>
        <label class="check">
            <input type="checkbox" checked="@Monthly" @onchange="ToggleMonthly" />
            повторять ежемесячно (каждое @(TargetDate.Day)-е число)
        </label>
    </div>

    @if (Target <= DateTime.Now)
    {
        <div class="alert error">@(Monthly ? "Ближайшая дата в будущем не найдена." : "Эта дата уже прошла. Выберите дату в будущем или включите ежемесячный повтор.")</div>
    }
    else
    {
        <div class="big-display clock-display">
            <div class="clock-time">@FormatLeft(Left)</div>
            <div class="clock-date">@Description</div>
        </div>
        <div class="result">
            <div class="result-detail">
                цель: @Target.ToString("dd.MM.yyyy HH:mm", _ru) ·
                осталось @Left.TotalDays.ToString("0.#") дней ·
                @Left.TotalHours.ToString("0") часов ·
                @Left.TotalMinutes.ToString("0") минут
            </div>
        </div>
    }
</div>

@code {
    private static readonly System.Globalization.CultureInfo _ru = new("ru-RU");

    public DateTime TargetDate { get; set; } = DateTime.Today.AddDays(14);
    public DateTime TargetTime { get; set; } = DateTime.Today;
    public bool Monthly { get; set; }

    private DateTime _now = DateTime.Now;
    private bool _disposed;

    /// <summary>Ближайшая цель: для ежемесячного повора — следующее N-е число месяца.</summary>
    private DateTime Target
    {
        get
        {
            var target = TargetDate.Date + TargetTime.TimeOfDay;
            if (!Monthly)
                return target;

            var day = Math.Clamp(TargetDate.Day, 1, 28); // 28-е есть в каждом месяце
            var candidate = new DateTime(DateTime.Now.Year, DateTime.Now.Month, day) + TargetTime.TimeOfDay;
            while (candidate <= DateTime.Now)
                candidate = candidate.AddMonths(1);
            return candidate;
        }
    }

    private TimeSpan Left => Target - _now;

    private string Description => Monthly
        ? $"до {TargetDate.Day}-го числа каждого месяца (ближайшее: {Target.ToString("dd.MM.yyyy HH:mm", _ru)})"
        : $"до {Target.ToString("dd.MM.yyyy HH:mm", _ru)}";

    protected override void OnInitialized()
    {
        _ = TickLoop();
    }

    private async Task TickLoop()
    {
        while (!_disposed)
        {
            _now = DateTime.Now;
            await InvokeAsync(StateHasChanged);
            await Task.Delay(500);
        }
    }

    private Task ToggleMonthly(ChangeEventArgs e)
    {
        Monthly = e.Value is bool b && b;
        return Task.CompletedTask;
    }

    private static string FormatLeft(TimeSpan left)
    {
        if (left.TotalDays >= 1)
            return $"{(int)left.TotalDays}д {left.Hours}ч {left.Minutes}м {left.Seconds}с";
        if (left.TotalHours >= 1)
            return $"{(int)left.TotalHours}ч {left.Minutes}м {left.Seconds}с";
        return $"{(int)left.TotalMinutes}м {left.Seconds}с";
    }
}
