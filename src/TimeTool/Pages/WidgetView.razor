@namespace TimeTool.Pages
@inject IJSRuntime JS
@inject Services.TimeState State
@inject Services.EventsStore Store

@if (_tab == "clock")
{
    <div class="widget-body">
        <div class="w-clock">@State.FormatTime(_now)</div>
        <div class="w-sub">@_now.ToString("ddd, d MMM", _ru) · @State.TimeZone.DisplayName.Split(')').LastOrDefault()?.Trim()</div>
    </div>
}
else if (_tab == "events")
{
    <div class="widget-body">
        @if (_events.Count == 0)
        {
            <div class="w-sub">Событий нет</div>
        }
        @foreach (var (e, next) in _events)
        {
            var left = next - _now;
            <div class="w-row">
                <span class="w-name">@e.Name</span>
                <span class="w-val">@CompactLeft(left)</span>
            </div>
        }
    </div>
}
else if (_tab == "timer")
{
    <div class="widget-body">
        <div class="w-clock">@Display</div>
        <div class="w-btns">
            @if (!IsRunning && !IsPaused)
            {
                <button class="btn btn-small primary" @onclick="Start">Старт</button>
            }
            else if (IsRunning)
            {
                <button class="btn btn-small" @onclick="Pause">Пауза</button>
                <button class="btn btn-small danger" @onclick="Reset">Сброс</button>
            }
            else
            {
                <button class="btn btn-small primary" @onclick="Resume">Далее</button>
                <button class="btn btn-small danger" @onclick="Reset">Сброс</button>
            }
        </div>
    </div>
}
else if (_tab == "stopwatch")
{
    <div class="widget-body">
        <div class="w-clock">@Elapsed.ToString(@"mm\:ss\.ff")</div>
        <div class="w-btns">
            @if (!IsRunning && !IsPaused)
            {
                <button class="btn btn-small primary" @onclick="SwStart">Старт</button>
            }
            else if (IsRunning)
            {
                <button class="btn btn-small" @onclick="SwPause">Пауза</button>
                <button class="btn btn-small" @onclick="SwLap">Отметить</button>
            }
            else
            {
                <button class="btn btn-small primary" @onclick="SwResume">Далее</button>
                <button class="btn btn-small danger" @onclick="SwReset">Сброс</button>
            }
        </div>
        @if (_lapCount > 0)
        {
            <div class="w-sub">отметок: @_lapCount · последняя @_lastLap.ToString(@"mm\:ss\.ff")</div>
        }
    </div>
}
else
{
    <div class="widget-body">
        <div class="w-row"><span class="w-name">Разница</span></div>
        <div class="w-btns">
            <input type="datetime-local" @bind="_aVal" @bind:event="oninput" />
            <input type="datetime-local" @bind="_bVal" @bind:event="oninput" />
        </div>
        @if (WidgetDiff is { } d)
        {
            <div class="w-val">@d.Days д @d.Hours ч @d.Minutes мин</div>
        }
    </div>
}

@code {
    private static readonly System.Globalization.CultureInfo _ru = new("ru-RU");
    private string _tab = "clock";
    private DateTime _now = DateTime.Now;
    private bool _disposed;

    // таймер
    private TimeSpan Total = TimeSpan.FromMinutes(5);
    private TimeSpan Remaining = TimeSpan.FromMinutes(5);
    private DateTime _endAt;
    private bool IsRunning { get; set; }
    private bool IsPaused { get; set; }
    private bool Finished { get; set; }
    private string Display => Remaining.ToString(@"hh\:mm\:ss");

    // секундомер
    private TimeSpan Elapsed { get; set; }
    private DateTime _swStarted;
    private TimeSpan _swAcc;
    private int _lapCount;
    private TimeSpan _lastLap;

    // события/калькулятор
    private List<(Services.EventItem e, DateTime next)> _events = new();
    public DateTime? _aVal { get; set; } = DateTime.Today.AddHours(8);
    public DateTime? _bVal { get; set; } = DateTime.Today.AddHours(17);
    private TimeSpan? WidgetDiff =>
        _aVal is { } a && _bVal is { } b
            ? (b >= a ? b - a : a - b)
            : null;

    protected override void OnInitialized()
    {
        _tab = Services.WidgetContext.Tab;
        _ = InitAsync();
        _ = TickLoop();
    }

    private async Task InitAsync()
    {
        await Store.InitAsync(JS);
        await InvokeAsync(StateHasChanged);
    }

    private async Task TickLoop()
    {
        while (!_disposed)
        {
            _now = DateTime.Now;
            if (IsRunning)
            {
                Remaining = _endAt - _now;
                if (Remaining <= TimeSpan.Zero)
                {
                    Remaining = TimeSpan.Zero;
                    IsRunning = false;
                    Finished = true;
                    try { await JS.InvokeVoidAsync("beep", 3); } catch { }
                }
            }
            if (_tab == "events")
            {
                _events = Store.Events
                    .Select(e => (e, Services.EventsStore.NextOccurrence(e, _now)))
                    .OrderBy(x => x.Item2)
                    .Take(4)
                    .ToList();
            }
            if (_tab == "stopwatch" && IsRunning)
                Elapsed = _swAcc + (_now - _swStarted);
            await InvokeAsync(StateHasChanged);
            await Task.Delay(500);
        }
    }

    private void Start()
    {
        Remaining = Total;
        IsPaused = false;
        IsRunning = true;
        _endAt = DateTime.Now + Remaining;
    }

    private void Resume()
    {
        IsPaused = false;
        IsRunning = true;
        _endAt = DateTime.Now + Remaining;
    }

    private void Pause()
    {
        IsRunning = false;
        IsPaused = true;
    }

    private void Reset()
    {
        IsRunning = false;
        IsPaused = false;
        Finished = false;
        Remaining = Total;
    }

    private void SwStart()
    {
        _swAcc = TimeSpan.Zero;
        Elapsed = TimeSpan.Zero;
        _lapCount = 0;
        IsRunning = true;
        _swStarted = DateTime.Now;
    }

    private void SwResume()
    {
        IsPaused = false;
        IsRunning = true;
        _swStarted = DateTime.Now;
    }

    private void SwPause()
    {
        _swAcc += DateTime.Now - _swStarted;
        Elapsed = _swAcc;
        IsRunning = false;
        IsPaused = true;
    }

    private void SwReset()
    {
        IsRunning = false;
        IsPaused = false;
        _swAcc = TimeSpan.Zero;
        Elapsed = TimeSpan.Zero;
        _lapCount = 0;
    }

    private void SwLap()
    {
        var total = _swAcc + (DateTime.Now - _swStarted);
        _lastLap = _lapCount == 0 ? total : total - _lastLapTotal;
        _lastLapTotal = total;
        _lapCount++;
    }

    private TimeSpan _lastLapTotal;

    private static string CompactLeft(TimeSpan left)
    {
        if (left.TotalDays >= 1)
            return $"{(int)left.TotalDays}д {(int)left.Hours}ч";
        if (left.TotalHours >= 1)
            return $"{(int)left.TotalHours}ч {left.Minutes}м";
        return $"{(int)left.TotalMinutes}м";
    }
}
