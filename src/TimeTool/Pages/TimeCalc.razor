@namespace TimeTool.Pages
@page "/calc"
@inject IJSRuntime JS

<PageTitle>Калькулятор</PageTitle>

<div class="page">
    <h2>Расчёт времени</h2>

    <div class="calc-grid">
        <section class="panel">
            <h3>Сумма интервалов</h3>
            <p class="hint">Например, смены: 7:00–14:00 и 15:00–18:00 = 10 часов. Конец раньше начала — интервал через полночь.</p>
            @for (var i = 0; i < _intervals.Count; i++)
            {
                var idx = i;
                <div class="interval-row">
                    <input type="time" @bind="_intervals[idx].Start" aria-label="Начало" />
                    <span>—</span>
                    <input type="time" @bind="_intervals[idx].End" aria-label="Конец" />
                    <span class="interval-dur">@IntervalText(_intervals[idx])</span>
                    <button type="button" class="btn btn-small danger" @onclick="() => RemoveInterval(idx)" disabled="@(_intervals.Count == 1)" title="Убрать строку">✕</button>
                </div>
            }
            <div class="controls" style="justify-content:flex-start;">
                <button type="button" class="btn btn-small" @onclick="AddInterval">＋ Добавить интервал</button>
                <button type="button" class="btn btn-small" @onclick="CopyIntervals" title="Скопировать сумму в буфер (markdown — для Obsidian)">Копировать</button>
            </div>
            <div class="result">
                <div class="result-main">Итого: @FormatTotal(IntervalsTotal)</div>
                <div class="result-detail">@($"{IntervalsTotal.TotalHours:0.#}") часов · @($"{(int)IntervalsTotal.TotalMinutes}") минут</div>
            </div>
        </section>

        <section class="panel">
            <h3>Разница между моментами</h3>
            <p class="hint">Можно печатать с клавиатуры — результат обновляется по мере ввода.</p>
            <label>Начало<input type="datetime-local" @bind="StartVal" @bind:event="oninput" /></label>
            <label>Конец<input type="datetime-local" @bind="EndVal" @bind:event="oninput" /></label>
            <div class="controls" style="justify-content:flex-start;">
                <button type="button" class="btn btn-small" @onclick="CopyDiff" disabled="@(Diff is null)" title="Скопировать в буфер (markdown — для Obsidian)">Копировать</button>
            </div>
            @if (StartValue is null || EndValue is null)
            {
                <div class="alert info">Введите обе даты — результат появится автоматически.</div>
            }
            else if (Diff.HasValue)
            {
                <div class="result">
                    <div class="result-main">@FormatDiff(Diff.Value)</div>
                    <div class="result-detail">
                        итого: @Diff.Value.TotalDays.ToString("0.###") дней ·
                        @Diff.Value.TotalHours.ToString("0.#") часов ·
                        @Diff.Value.TotalMinutes.ToString("0") минут ·
                        @Diff.Value.TotalSeconds.ToString("0") секунд
                    </div>
                </div>
            }
        </section>

        <section class="panel">
            <h3>Сдвиг даты</h3>
            <label>Исходная дата и время<input type="datetime-local" @bind="BaseValue" @bind:format="yyyy-MM-ddTHH:mm" /></label>
            <div class="shift-row">
                <label>Интервал<input type="number" min="0" @bind="ShiftValue" /></label>
                <label>Единицы
                    <select @bind="ShiftUnit">
                        <option value="minutes">минуты</option>
                        <option value="hours">часы</option>
                        <option value="days">дни</option>
                        <option value="weeks">недели</option>
                        <option value="months">месяцы</option>
                        <option value="years">годы</option>
                    </select>
                </label>
                <label>Направление
                    <select @bind="ShiftSign">
                        <option value="+">плюс (+)</option>
                        <option value="-">минус (−)</option>
                    </select>
                </label>
            </div>
            <div class="controls" style="justify-content:flex-start;">
                <button type="button" class="btn btn-small" @onclick="CopyShift" title="Скопировать в буфер (markdown — для Obsidian)">Копировать</button>
            </div>
            @if (ShiftError is not null)
            {
                <div class="alert error">@ShiftError</div>
            }
            else if (ShiftResult.HasValue)
            {
                <div class="result">
                    <div class="result-main">@ShiftResult.Value.ToString("dd.MM.yyyy HH:mm ddd")</div>
                    <div class="result-detail">@BaseValue.ToString("dd.MM.yyyy HH:mm") @(ShiftSign == "-" ? "−" : "+") @ShiftValue @UnitName</div>
                </div>
            }
        </section>

        <section class="panel">
            <h3>Конвертер единиц</h3>
            <div class="shift-row">
                <label>Значение<input type="number" min="0" @bind="ConvValue" /></label>
                <label>Единицы
                    <select @bind="ConvUnit">
                        <option value="seconds">секунды</option>
                        <option value="minutes">минуты</option>
                        <option value="hours">часы</option>
                        <option value="days">дни</option>
                        <option value="weeks">недели</option>
                        <option value="months">месяцы (≈30,44 дн)</option>
                        <option value="years">годы (≈365,24 дн)</option>
                    </select>
                </label>
            </div>
            @if (ConvTotal is { } ct)
            {
                <div>
                    @ConvRow("Недели", ct.TotalDays / 7)
                    @ConvRow("Дни", ct.TotalDays)
                    @ConvRow("Часы", ct.TotalHours)
                    @ConvRow("Минуты", ct.TotalMinutes)
                    @ConvRow("Секунды", ct.TotalSeconds)
                    @ConvRow("Месяцы (≈)", ct.TotalDays / 30.4369)
                    @ConvRow("Годы (≈)", ct.TotalDays / 365.2425)
                </div>
            }
        </section>
    </div>
</div>

@code {
    private sealed class Interval
    {
        public DateTime Start { get; set; } = DateTime.Today.AddHours(7);
        public DateTime End { get; set; } = DateTime.Today.AddHours(14);
    }

    private readonly List<Interval> _intervals = new() { new Interval(), new Interval { Start = DateTime.Today.AddHours(15), End = DateTime.Today.AddHours(18) } };

    private TimeSpan IntervalsTotal
    {
        get
        {
            var sum = TimeSpan.Zero;
            foreach (var iv in _intervals)
            {
                var start = iv.Start.TimeOfDay;
                var end = iv.End.TimeOfDay;
                var d = end >= start ? end - start : end + TimeSpan.FromDays(1) - start;
                sum += d;
            }
            return sum;
        }
    }

    private static string FormatTotal(TimeSpan t) =>
        $"{(int)t.TotalHours}:{t.Minutes:D2}:{t.Seconds:D2}";

    private static string IntervalText(Interval iv)
    {
        var start = iv.Start.TimeOfDay;
        var end = iv.End.TimeOfDay;
        var d = end >= start ? end - start : end + TimeSpan.FromDays(1) - start;
        return $"{(int)d.TotalHours}:{d.Minutes:D2}";
    }

    private void AddInterval() => _intervals.Add(new Interval());

    private void RemoveInterval(int idx) => _intervals.RemoveAt(idx);

    private async Task CopyIntervals()
    {
        var md = $"**Сумма интервалов:** {FormatTotal(IntervalsTotal)} ({IntervalsTotal.TotalHours:0.#} ч)";
        try { await JS.InvokeAsync<object>("navigator.clipboard.writeText", md); } catch { }
    }

    private async Task CopyDiff()
    {
        if (Diff is not { } d)
            return;
        var md = $"**Разница:** {FormatDiff(d)} ({d.TotalDays:0.#} дн / {d.TotalHours:0.#} ч)";
        try { await JS.InvokeAsync<object>("navigator.clipboard.writeText", md); } catch { }
    }

    private async Task CopyShift()
    {
        if (ShiftResult is not { } r)
            return;
        var md = $"**{BaseValue:dd.MM.yyyy HH:mm}** {(ShiftSign == "-" ? "−" : "+")} {ShiftValue} {UnitName} = **{r:dd.MM.yyyy HH:mm}**";
        try { await JS.InvokeAsync<object>("navigator.clipboard.writeText", md); } catch { }
    }
    public DateTime? StartVal { get; set; } = DateTime.Today.AddHours(8);
    public DateTime? EndVal { get; set; } = DateTime.Today.AddHours(17);
    public DateTime BaseValue { get; set; } = DateTime.Now;

    public int ShiftValue { get; set; } = 14;
    public string ShiftUnit { get; set; } = "days";
    public string ShiftSign { get; set; } = "+";

    public int ConvValue { get; set; } = 40;
    public string ConvUnit { get; set; } = "hours";

    private DateTime? StartValue => StartVal;
    private DateTime? EndValue => EndVal;

    private TimeSpan? Diff => StartValue is { } s && EndValue is { } e
        ? (e >= s ? e - s : s - e)
        : null;

    private TimeSpan? ConvTotal
    {
        get
        {
            if (ConvValue < 0)
                return null;
            return ConvUnit switch
            {
                "seconds" => TimeSpan.FromSeconds(ConvValue),
                "hours" => TimeSpan.FromHours(ConvValue),
                "days" => TimeSpan.FromDays(ConvValue),
                "weeks" => TimeSpan.FromDays(ConvValue * 7),
                "months" => TimeSpan.FromDays(ConvValue * 30.4369),
                "years" => TimeSpan.FromDays(ConvValue * 365.2425),
                _ => TimeSpan.FromMinutes(ConvValue),
            };
        }
    }

    private RenderFragment ConvRow(string name, double value) => __builder =>
    {
        var text = value.ToString("0.###");
        <div class="conv-row">
            <span>@name</span>
            <span class="conv-val">@text</span>
            <button type="button" class="btn btn-small" @onclick="() => CopyValue(text)" title="Скопировать">⧉</button>
        </div>
    };

    private async Task CopyValue(string text)
    {
        try { await JS.InvokeAsync<object>("navigator.clipboard.writeText", text); } catch { }
    }

    private string? ShiftError
    {
        get
        {
            if (ShiftValue < 0)
                return "Интервал не может быть отрицательным.";
            return null;
        }
    }

    private DateTime? ShiftResult
    {
        get
        {
            if (ShiftValue < 0)
                return null;
            if (ShiftUnit == "months")
                return ShiftSign == "-" ? BaseValue.AddMonths(-ShiftValue) : BaseValue.AddMonths(ShiftValue);
            if (ShiftUnit == "years")
                return ShiftSign == "-" ? BaseValue.AddYears(-ShiftValue) : BaseValue.AddYears(ShiftValue);
            var amount = ShiftUnit switch
            {
                "hours" => TimeSpan.FromHours(ShiftValue),
                "days" => TimeSpan.FromDays(ShiftValue),
                "weeks" => TimeSpan.FromDays(ShiftValue * 7),
                _ => TimeSpan.FromMinutes(ShiftValue),
            };
            return ShiftSign == "-" ? BaseValue - amount : BaseValue + amount;
        }
    }

    private string UnitName => ShiftUnit switch
    {
        "hours" => "час.",
        "days" => "дн.",
        "weeks" => "нед.",
        "months" => "мес.",
        "years" => "г.",
        _ => "мин.",
    };

    private static string FormatDiff(TimeSpan d)
    {
        var days = (int)d.TotalDays;
        var h = d.Hours;
        var m = d.Minutes;
        var parts = new List<string>();
        if (days > 0)
            parts.Add($"{days} {(days % 10 == 1 && days % 100 != 11 ? "день" : days % 10 is >= 2 and <= 4 && (days % 100 < 10 || days % 100 >= 20) ? "дня" : "дней")}");
        if (h > 0 || days > 0)
            parts.Add($"{h} {(h % 10 == 1 && h % 100 != 11 ? "час" : h % 10 is >= 2 and <= 4 && (h % 100 < 10 || h % 100 >= 20) ? "часа" : "часов")}");
        parts.Add($"{m} {(m % 10 == 1 && m % 100 != 11 ? "минута" : m % 10 is >= 2 and <= 4 && (m % 100 < 10 || m % 100 >= 20) ? "минуты" : "минут")}");
        return string.Join(" ", parts);
    }
}
