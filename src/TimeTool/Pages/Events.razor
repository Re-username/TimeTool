@namespace TimeTool.Pages

@page "/"
@page "/events"
@inject IJSRuntime JS
@inject Services.EventsStore Store
@inject Services.TimeState State

<PageTitle>События</PageTitle>

<div class="page">
    <h2>События и отсчёты</h2>

    <div class="panel">
        <div class="shift-row">
            <label style="flex:2; min-width:160px;">Название
                <input @bind="_name" placeholder="Например: Зарплата" />
            </label>
            <label>Дата
                <input type="date" @bind="_date" />
            </label>
            <label>Время
                <input type="time" @bind="_time" />
            </label>
        </div>
        <div class="shift-row">
            <label>Повтор
                <select @bind="_repeat">
                    <option value="none">не повторять</option>
                    <option value="daily">каждый день</option>
                    <option value="weekly">каждую неделю</option>
                    <option value="monthly">каждый месяц</option>
                    <option value="yearly">каждый год</option>
                </select>
            </label>
            <label>Выходные
                <select @bind="_weekend">
                    <option value="none">не переносить</option>
                    <option value="friday">перенести на пятницу</option>
                    <option value="monday">перенести на понедельник</option>
                </select>
            </label>
            <label>Напоминание
                <select @bind="_remind">
                    <option value="0">выключено</option>
                    <option value="-1">вовремя</option>
                    <option value="60">за 1 час</option>
                    <option value="180">за 3 часов</option>
                    <option value="720">за 12 часов</option>
                    <option value="1440">за 1 день</option>
                    <option value="4320">за 3 дней</option>
                </select>
            </label>
            <label class="grow2">Звук события
                <input @bind="_soundPath" placeholder="не выбран" />
            </label>
            <button type="button" class="btn form-btn" @onclick="PickSound">Обзор…</button>
        </div>
        <div class="shift-row">
            <label class="grow2">Заметка
                <input @bind="_note" placeholder="Необязательно: комментарий к событию" />
            </label>
            @if (_editingId is null)
            {
                <button type="button" class="btn primary form-btn" @onclick="Add" disabled="@string.IsNullOrWhiteSpace(_name)">Добавить</button>
            }
            else
            {
                <button type="button" class="btn primary form-btn" @onclick="SaveEdit" disabled="@string.IsNullOrWhiteSpace(_name)">Сохранить</button>
                <button type="button" class="btn form-btn" @onclick="CancelEdit">Отмена</button>
            }
        </div>
        @if (_editingId is not null)
        {
            <div class="alert info" style="margin-top:8px;">Редактируется событие — изменения применятся после «Сохранить».</div>
        }
    </div>

    @if (Store.Events.Count == 0)
    {
        <div class="alert info">Событий нет. Добавьте, например, «Зарплата» 25-го числа с повтором «каждый месяц» — отсчёт будет вестись до ближайшего 25-го, а после него сам переключится на следующий месяц.</div>
    }
    else
    {
        <div class="events-list">
            @foreach (var e in Store.Events.OrderBy(x => Services.EventsStore.NextOccurrence(x, _now)))
            {
                var next = Services.EventsStore.NextOccurrence(e, _now);
                var left = next - _now;
                var happening = Services.EventsStore.IsHappening(e, _now);
                var overdue = Services.EventsStore.IsOverdue(e, _now);
                var css = "event-card" + (happening ? " due" : overdue ? " overdue" : "");
                <div class="@css">
                    <div class="event-main">
                        <div class="event-name">
                            @e.Name
                            @if (happening)
                            {
                                <span class="due-badge">наступило!</span>
                            }
                        </div>
                        <div class="event-when">
                            @(e.Repeat switch
                            {
                                "daily" => "каждый день",
                                "weekly" => $"каждую {WeekdayName(e.Date.DayOfWeek)}",
                                "monthly" => $"каждое {e.Date.Day}-е число",
                                "yearly" => $"каждый год, {e.Date.ToString("d MMMM", _ru)}",
                                _ => "однократно",
                            })
                            · ближайшее: @next.ToString("dd.MM.yyyy HH:mm", _ru)
                            @if (e.WeekendShift == "friday")
                            {
                                <span> · выходные → пятница</span>
                            }
                            else if (e.WeekendShift == "monday")
                            {
                                <span> · выходные → понедельник</span>
                            }
                        </div>
                        @if (!string.IsNullOrWhiteSpace(e.Note))
                        {
                            <div class="event-note">@e.Note</div>
                        }
                        @if (e.RemindLeadMinutes != 0)
                        {
                            <div class="event-when">напоминание @(e.RemindLeadMinutes < 0 ? "вовремя" : $"за {LeadText(e.RemindLeadMinutes)}")</div>
                        }
                    </div>
                    <div class="event-left">
                        <div class="event-count">@Services.EventsStore.FormatLeft(left, out var wasOverdue)</div>
                        <div class="event-when">@left.TotalDays.ToString("0.#") дней</div>
                    </div>
                    <div class="event-actions">
                        <button type="button" class="btn btn-small" @onclick="() => Edit(e)" title="Изменить (название, дату, заметку…)">Изменить</button>
                        <button type="button" class="btn btn-small" @onclick="() => CopyEvent(e, next, left)" title="Скопировать отсчёт в буфер (markdown — для Obsidian)">Копировать</button>
                        <button type="button" class="btn btn-small danger" @onclick="() => Remove(e)" title="Удалить">✕</button>
                    </div>
                </div>
            }
        </div>
    }
</div>

@code {
    private static readonly System.Globalization.CultureInfo _ru = new("ru-RU");

    private string _name = "";
    private DateTime _date = DateTime.Today.AddDays(7);
    private DateTime _time = DateTime.Today;
    private string _repeat = "monthly";
    private string _weekend = "none";
    private string _remind = "1440";
    private string _soundPath = "";
    private string _note = "";
    private string? _editingId;
    private DateTime _now = DateTime.Now;
    private bool _disposed;

    protected override void OnInitialized()
    {
        _ = InitAsync();
        _ = TickLoop();
    }

    private async Task InitAsync()
    {
        await Store.InitAsync(JS);
        await InvokeAsync(StateHasChanged);
    }

    private async Task TickLoop()
    {
        while (!_disposed)
        {
            try
            {
                _now = DateTime.Now;
                await InvokeAsync(StateHasChanged);
            }
            catch (InvalidOperationException) { break; } // компонент уничтожен при навигации
            await Task.Delay(1000);
        }
    }

    private async Task Add()
    {
        await Store.AddAsync(new Services.EventItem
        {
            Name = _name.Trim(),
            Date = _date.Date + _time.TimeOfDay,
            Repeat = _repeat,
            WeekendShift = _weekend,
            RemindLeadMinutes = int.TryParse(_remind, out var r) ? r : 0,
            SoundPath = string.IsNullOrWhiteSpace(_soundPath) ? null : _soundPath.Trim(),
            Note = string.IsNullOrWhiteSpace(_note) ? null : _note.Trim(),
        });
        _name = "";
        _note = "";
    }

    private void Edit(Services.EventItem e)
    {
        _editingId = e.Id;
        _name = e.Name;
        _date = e.Date;
        _time = e.Date;
        _repeat = e.Repeat;
        _weekend = e.WeekendShift;
        _remind = e.RemindLeadMinutes.ToString();
        _soundPath = e.SoundPath ?? "";
        _note = e.Note ?? "";
    }

    private async Task SaveEdit()
    {
        if (_editingId is null)
            return;
        var id = _editingId;
        await Store.UpdateAsync(id, e =>
        {
            e.Name = _name.Trim();
            e.Date = _date.Date + _time.TimeOfDay;
            e.Repeat = _repeat;
            e.WeekendShift = _weekend;
            e.RemindLeadMinutes = int.TryParse(_remind, out var r) ? r : 0;
            e.SoundPath = string.IsNullOrWhiteSpace(_soundPath) ? null : _soundPath.Trim();
            e.Note = string.IsNullOrWhiteSpace(_note) ? null : _note.Trim();
        });
        CancelEdit();
    }

    private void CancelEdit()
    {
        _editingId = null;
        _name = "";
        _note = "";
        _soundPath = "";
    }

    private async Task PickSound()
    {
#if WINDOWS
        var path = await Platforms.Windows.AudioPick.PickAudioAsync();
        if (!string.IsNullOrEmpty(path))
            _soundPath = path;
#endif
    }

    private async Task Remove(Services.EventItem e) => await Store.RemoveAsync(e.Id);

    private async Task CopyEvent(Services.EventItem e, DateTime next, TimeSpan left)
    {
        var md = $"**{e.Name}** — осталось {Services.EventsStore.FormatLeft(left, out _)} (до {next.ToString("dd.MM.yyyy HH:mm", _ru)})";
        if (!string.IsNullOrWhiteSpace(e.Note))
            md += $"\n> {e.Note}";
        try { await JS.InvokeAsync<object>("navigator.clipboard.writeText", md); } catch { }
    }

    private static string WeekdayName(DayOfWeek d) => d switch
    {
        DayOfWeek.Monday => "понедельник",
        DayOfWeek.Tuesday => "вторник",
        DayOfWeek.Wednesday => "среду",
        DayOfWeek.Thursday => "четверг",
        DayOfWeek.Friday => "пятницу",
        DayOfWeek.Saturday => "субботу",
        _ => "воскресенье",
    };

    private static string LeadText(int minutes) => minutes switch
    {
        60 => "1 час",
        180 => "3 часов",
        720 => "12 часов",
        1440 => "1 день",
        4320 => "3 дней",
        _ => $"{minutes} мин",
    };
}
