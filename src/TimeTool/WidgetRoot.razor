@namespace TimeTool

@inject IJSRuntime JS

@if (_widgetTab is null)
{
    <Router AppAssembly="@typeof(Root).Assembly">
        <Found Context="routeData">
            <RouteView RouteData="@routeData" DefaultLayout="@typeof(Layout.MainLayout)" />
        </Found>
        <NotFound>
            <LayoutView Layout="@typeof(Layout.MainLayout)">
                <p role="alert">Здесь ничего нет.</p>
            </LayoutView>
        </NotFound>
    </Router>
}
else
{
    <Pages.WidgetView />
}

@code {
    private string? _widgetTab;

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            try
            {
                _widgetTab = await JS.InvokeAsync<string?>("getWidgetTab");
            }
            catch { }
            if (_widgetTab is not null)
                await InvokeAsync(StateHasChanged);
        }
    }
}
