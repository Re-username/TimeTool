<?xml version="1.0" encoding="UTF-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:ui="clr-namespace:TimeTool"
             x:Class="TimeTool.WidgetPage"
             BackgroundColor="#10151c">
    <BlazorWebView x:Name="blazorWebView" HostPage="wwwroot/widget.html">
        <BlazorWebView.RootComponents>
            <RootComponent Selector="#app" ComponentType="{x:Type ui:WidgetRoot}" />
        </BlazorWebView.RootComponents>
    </BlazorWebView>
</ContentPage>
